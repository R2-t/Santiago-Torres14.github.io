---
import DynamicSvg from "@components/DynamicSvg.astro";
import ContactInformationItem from "@components/ContactInformationItem.astro";

interface Props {
  name: string;
  position: string;
  contactInformation: {
    phone?: string;
    email?: string;
    location?: string;
    calendar?: string;
  };
  socialMedia: {
    github?: string;
    linkedin?: string;
  };
}

const { name, position, contactInformation, socialMedia } = Astro.props;
---

<section class="flex lg:sticky lg:w-1/3 items-center justify-center">
  <div class="w-full max-w-md">
    <div
      class="bg-white rounded-3xl shadow-2xl overflow-hidden backdrop-blur-sm"
    >
      <!-- Profile Picture -->
      <div id="profile-pic" class="flex justify-center pt-12 pb-8">
        <div class="relative group">
          <img
            src={""}
            alt={name}
            class="relative w-40 h-40 md:w-48 md:h-48 rounded-3xl object-cover border-4 border-indigo-400/20 shadow-xl"
          />
        </div>
      </div>

      <div id="profile-info" class="px-8 pb-8">
        <!-- Name and Title -->
        <div id="name-title" class="text-center mb-8">
          <h1
            class="text-3xl md:text-4xl font-bold text-slate mb-2 tracking-tight"
          >
            {name}
          </h1>
          <p class="text-gray-400 text-lg font-medium tracking-wide">
            {position}
          </p>
        </div>

        <!-- Social Links -->
        <div id="social-links" class="flex justify-center gap-3 mb-10">
          {
            Object.entries(socialMedia).map(([platform, url]) => (
              <a
                href={url}
                class="w-12 h-12 bg-indigo-400 rounded-xl flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-indigo-500/50 group"
              >
                <DynamicSvg name={platform} />
              </a>
            ))
          }
        </div>

        <!-- Contact Information -->
        <div id="contact-information" class="space-y-6 mb-8">
          {
            Object.entries(contactInformation).map(([key, value]) => (
              <ContactInformationItem title={key} value={value}>
                <DynamicSvg name={key} />
              </ContactInformationItem>
            ))
          }
          <!-- Download CV Button -->
          <div id="download-cv-btn">
            <button
              class="w-full bg-indigo-400 hover:from-indigo-400/30 text-white font-bold py-4 rounded-2xl transition-all duration-300 hover:shadow-xl hover:shadow-indigo-500/50 hover:scale-[1.02] active:scale-[0.98]"
            >
              Download CV
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Custom animations */
    @keyframes float {
      0%,
      100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-10px);
      }
    }

    #profile-pic img {
      animation: float 6s ease-in-out infinite;
    }

    /* Smooth transitions for all interactive elements */
    button,
    a {
      transition-property: all;
      transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
      transition-duration: 300ms;
    }
  </style>
</section>
