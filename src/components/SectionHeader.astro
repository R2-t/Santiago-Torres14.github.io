---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="flex items-center gap-3 mb-6">
  <!-- Title -->
  <div
    class="w-5 h-5 rounded-full border-2 border-indigo-400 flex items-center justify-center shrink-0"
  >
    <div class="w-2 h-2 rounded-full bg-indigo-400"></div>
  </div>
  <h2 class="text-2xl md:text-3xl font-bold text-slate tracking-tight">
    {title}
  </h2>
</div>
