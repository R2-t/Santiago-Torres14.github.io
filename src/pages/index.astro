---
import NewLayout from "@layout/NewLayout.astro";
import PresentationCard from "@components/PresentationCard.astro";
import InformationCard from "@components/InformationCard.astro";
import {
  description,
  name,
  position,
  email,
  github_url,
  linkedin_url,
} from "@data/personal-info";
---

<NewLayout title="index">
  <PresentationCard
    name={name}
    position={position}
    contactInformation={{
      email: email,
      location: "Bogotá, Colombia",
    }}
    socialMedia={{
      github: github_url,
      linkedin: linkedin_url,
    }}
  />
  <InformationCard description={description} />
</NewLayout>
